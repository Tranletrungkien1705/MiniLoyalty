@using MiniLoyalty.Services
@{
    ViewData["Title"] = "Tra cứu hội viên cho DMS";
    var carNo = (string?)ViewBag.CarNo;
    var vin = (string?)ViewBag.Vin;
    var dlcpCode = (string?)ViewBag.DlcpCode;
    var result = ViewBag.Result as DmsMemberLookup;
    var searched = !string.IsNullOrWhiteSpace(carNo) || !string.IsNullOrWhiteSpace(vin);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-search me-2"></i>Tra cứu hội viên cho DMS</h5>
        <small class="text-muted">Crd_MemberController.GetDetailForDMS — tìm hội viên theo biển số (CarNo) hoặc số khung (VIN)</small></div>
</div>

<div class="card mb-3"><div class="card-body">
    <form asp-action="Index" method="get" class="row g-3">
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Biển số xe (CarNo)</label>
            <input name="carNo" value="@carNo" class="form-control form-control-sm" placeholder="30A-123.45" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Số khung (VIN)</label>
            <input name="vin" value="@vin" class="form-control form-control-sm" placeholder="RL4DEMO0000000001" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Đại lý tra cứu (DLCPCode)</label>
            <input name="dlcpCode" value="@dlcpCode" class="form-control form-control-sm" placeholder="DL-DEMO-001" />
        </div>
        <div class="col-12">
            <button class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Tra cứu</button>
            <span class="small text-muted ms-2">Nhập biển số HOẶC số khung. Đại lý dùng để xác định đã từng đăng ký/tra cứu hội viên này chưa.</span>
        </div>
    </form>
</div></div>

@if (searched)
{
    if (result?.Member == null)
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Không tìm thấy hội viên theo biển số/VIN đã nhập.</div>
    }
    else
    {
        var m = result.Member;
        <div class="card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h6 class="fw-bold mb-0">@m.Name <span class="text-muted small font-monospace">@m.Code</span></h6>
                    <small class="text-muted">@(m.RankTier?.Name ?? "—") · tham gia @m.JoinedAt.ToString("dd/MM/yyyy")</small>
                </div>
                @if (result.FlagIsDLQuery == 1)
                {
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-check2-circle me-1"></i>Đại lý đã tra cứu/đăng ký (FlagIsDLQuery = 1)</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-dash-circle me-1"></i>Đại lý chưa tra cứu (FlagIsDLQuery = 0)</span>
                }
            </div>
            <div class="row g-2 small">
                <div class="col-md-4 text-muted">Số điện thoại: <b class="text-dark">@(m.Phone ?? "—")</b></div>
                <div class="col-md-4 text-muted">Biển số: <b class="text-dark">@(m.CarNo ?? "—")</b></div>
                <div class="col-md-4 text-muted">Số khung (VIN): <b class="text-dark">@(m.VIN ?? "—")</b></div>
                <div class="col-md-4 text-muted">Điểm khả dụng: <b class="text-dark">@m.Points.ToString("N0")</b></div>
                <div class="col-md-4 text-muted">Điểm tích lũy: <b class="text-dark">@m.LifetimePoints.ToString("N0")</b></div>
                <div class="col-md-4 text-muted">Lượt dịch vụ trong kỳ: <b class="text-dark">@m.QtyVisitAvail</b></div>
                <div class="col-md-4 text-muted">Trạng thái: <b class="text-dark">@m.Status</b></div>
            </div>
            <div class="mt-3">
                <a asp-controller="Member" asp-action="Details" asp-route-id="@m.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-person-lines-fill me-1"></i>Xem chi tiết hội viên</a>
            </div>
        </div></div>
    }
}
