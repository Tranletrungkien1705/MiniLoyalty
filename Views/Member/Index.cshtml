@model List<Member>
@{
    ViewData["Title"] = "Hội viên";
    var ranks = (List<RankTier>)ViewBag.Ranks;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-people-fill me-2"></i>Hội viên</h5><small class="text-muted">@Model.Count hội viên</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-person-plus me-1"></i>Thêm hội viên</a>
</div>
<form method="get" class="card p-3 mb-3"><div class="row g-2 align-items-end">
    <div class="col-auto"><label class="form-label small mb-1">Hạng thẻ</label>
        <select name="rankId" class="form-select form-select-sm"><option value="">Tất cả</option>
            @foreach (var r in ranks){<option value="@r.Id" selected="@((ViewBag.RankId as int?)==r.Id)">@r.Name</option>}</select></div>
    <div class="col"><label class="form-label small mb-1">Tìm kiếm</label>
        <input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Tên / mã / SĐT" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary btn-sm">Lọc</button> <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Xóa</a></div>
</div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã HV</th><th>Họ tên</th><th>SĐT</th><th>Hạng thẻ</th><th class="text-end">Điểm khả dụng</th><th class="text-end">Tích lũy</th><th>Tham gia</th></tr></thead>
    <tbody>
        @if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-4 d-block mb-2"></i>Không có hội viên</td></tr>}
        @foreach (var m in Model)
        {
            <tr style="cursor:pointer" onclick="location.href='/Member/Details/@m.Id'">
                <td class="font-monospace small fw-semibold">@m.Code</td>
                <td class="fw-semibold">@m.Name</td>
                <td class="small">@m.Phone</td>
                <td><span class="rank-chip" style="background:@m.RankTier?.ColorHex">@m.RankTier?.Name</span> <span class="small text-muted">@m.RankTier?.DiscountPercent%</span></td>
                <td class="text-end fw-bold">@m.Points.ToString("N0")</td>
                <td class="text-end text-muted">@m.LifetimePoints.ToString("N0")</td>
                <td class="small text-muted">@m.JoinedAt.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table></div></div>
