@model Member
@{
    ViewData["Title"] = $"Hội viên {Model.Code}";
    var rewards = (List<Reward>)ViewBag.Rewards;
    var discounts = (List<MemberDiscountTransaction>)ViewBag.Discounts;
    var vouchers = (List<MemberVoucherTransaction>)ViewBag.Vouchers;
    var promotions = (List<Promotion>)ViewBag.Promotions;
    var promotionUses = (List<MemberPromotionUse>)ViewBag.PromotionUses;
    string TxName(PointTxType t) => t switch { PointTxType.Earn=>"Tích điểm", PointTxType.Redeem=>"Đổi quà", PointTxType.Birthday=>"Sinh nhật", PointTxType.Adjust=>"Điều chỉnh", PointTxType.Expiry=>"Hết hạn", PointTxType.Introduction=>"Giới thiệu", PointTxType.ServiceTurn=>"Lượt dịch vụ", PointTxType.PointUse=>"Dùng ưu đãi", PointTxType.Sale=>"Mua xe mới", PointTxType.Consumption=>"Tiêu dùng dịch vụ", PointTxType.Kmbh=>"Khuyến mại bán hàng", PointTxType.PrProgram=>"Ghi nhận ưu đãi", PointTxType.PointIncrease=>"Tích điểm xét hạng", PointTxType.OpenCard=>"Mở thẻ mới", PointTxType.Support=>"Điều chỉnh hỗ trợ", _=>t.ToString() };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-person-badge me-2"></i>@Model.Name
            @if (Model.Status == MemberStatus.Cancel) { <span class="badge bg-danger-subtle text-danger ms-1">Đã vô hiệu hoá</span> }
            else { <span class="badge bg-success-subtle text-success ms-1">Đang hoạt động</span> }</h5>
        <small class="text-muted font-monospace">@Model.Code · @Model.Phone</small></div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card mb-3" style="background:linear-gradient(135deg,@Model.RankTier?.ColorHex,#2a1220);color:#fff"><div class="card-body">
            <div class="d-flex justify-content-between"><span class="rank-chip" style="background:rgba(255,255,255,.25)">@Model.RankTier?.Name</span>
                <i class="bi bi-award-fill fs-3 opacity-75"></i></div>
            <div class="mt-3" style="font-size:12px;opacity:.85;text-transform:uppercase;letter-spacing:1px">Điểm khả dụng</div>
            <div style="font-size:34px;font-weight:800;line-height:1.1">@Model.Points.ToString("N0")</div>
            <div class="mt-2" style="font-size:13px;opacity:.9">Tích lũy trọn đời: <b>@Model.LifetimePoints.ToString("N0")</b></div>
            <div style="font-size:13px;opacity:.9">Chiết khấu hạng: <b>@Model.RankTier?.DiscountPercent%</b></div>
            <div style="font-size:13px;opacity:.9">Lượt dịch vụ trong kỳ: <b>@Model.QtyVisitAvail</b></div>
            <div style="font-size:13px;opacity:.9">Điểm voucher: <b>@Model.PointVoucher.ToString("N0")</b></div>
            <div class="mt-2" style="font-size:12px;opacity:.75">Tham gia @Model.JoinedAt.ToString("dd/MM/yyyy")@if(Model.Dob.HasValue){<span> · Sinh nhật @Model.Dob.Value.ToString("dd/MM")</span>}</div>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-plus-circle me-1"></i>Tích điểm từ mua hàng</h6>
            <form asp-action="Earn" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="amount" type="number" step="1000" min="0" class="form-control form-control-sm" placeholder="Số tiền (đ)" required /></div>
                <div class="col-5"><button class="btn btn-primary btn-sm w-100">Tích điểm</button></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Ghi chú / số HĐ" /></div>
            </form>
            <hr class="my-2" />
            <form asp-action="Adjust" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="points" type="number" class="form-control form-control-sm" placeholder="+/- điểm điều chỉnh" required /></div>
                <div class="col-5"><button class="btn btn-outline-primary btn-sm w-100">Điều chỉnh</button></div>
            </form>
            <hr class="my-2" />
            <form asp-action="ServiceTurn" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="qty" type="number" value="1" min="1" class="form-control form-control-sm" placeholder="Số lượt dịch vụ" required /></div>
                <div class="col-5"><button class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-tools me-1"></i>Ghi lượt DV</button></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Ghi chú / số RO" /></div>
            </form>
            <hr class="my-2" />
            <form asp-action="Consumption" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="amount" type="number" step="1000" min="0" class="form-control form-control-sm" placeholder="Doanh thu RO dịch vụ (đ)" required /></div>
                <div class="col-5"><button class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-receipt me-1"></i>Tích điểm DV</button></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Ghi chú / số RO" /></div>
            </form>
            <hr class="my-2" />
            <form asp-action="Discount" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="amount" type="number" step="1000" min="0" class="form-control form-control-sm" placeholder="Doanh thu dịch vụ (đ)" required /></div>
                <div class="col-5"><button class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-percent me-1"></i>Chiết khấu</button></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Ghi chú / số RO" /></div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-graph-up-arrow me-1"></i>Tích điểm xét hạng (hỗ trợ)</h6>
            <div class="small text-muted mb-2">Điểm xét hạng trong kỳ: <b>@Model.PointCardRank.ToString("N0")</b> — cộng thêm điểm xét hạng, KHÔNG đổi điểm khả dụng</div>
            <form asp-action="PointIncrease" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="rankPoints" type="number" min="1" class="form-control form-control-sm" placeholder="Điểm xét hạng cộng thêm" required /></div>
                <div class="col-5"><button class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-plus-circle me-1"></i>Cộng điểm</button></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Ghi chú / số tham chiếu" /></div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-car-front me-1"></i>Tặng điểm mua xe mới</h6>
            <div class="small text-muted mb-2">Điểm thưởng mua xe (PointBuyCar): <b>@Model.PointBuyCar.ToString("N0")</b> điểm</div>
            <form asp-action="BuyNewCar" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="points" type="number" min="1" value="@(Model.PointBuyCar > 0 ? Model.PointBuyCar : (int?)null)" class="form-control form-control-sm" placeholder="Điểm thưởng (mặc định PointBuyCar)" /></div>
                <div class="col-5"><button class="btn btn-outline-success btn-sm w-100"><i class="bi bi-gift me-1"></i>Tặng điểm</button></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Số HĐ / VIN / ghi chú" /></div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-megaphone me-1"></i>Điểm khuyến mại bán hàng (HTV)</h6>
            <div class="small text-muted mb-2">Điểm khuyến mại (PointBuyCreta): <b>@Model.PointBuyCreta.ToString("N0")</b> điểm — HTV tặng thêm khi mua xe khuyến mại</div>
            <form asp-action="Kmbh" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="points" type="number" min="1" value="@(Model.PointBuyCreta > 0 ? Model.PointBuyCreta : (int?)null)" class="form-control form-control-sm" placeholder="Điểm khuyến mại (mặc định PointBuyCreta)" /></div>
                <div class="col-5"><button class="btn btn-outline-success btn-sm w-100"><i class="bi bi-gift me-1"></i>Tặng điểm</button></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Số HĐ / VIN / ghi chú" /></div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-car-front-fill me-1"></i>Tính điểm khuyến mại bán hàng Creta</h6>
            <div class="small text-muted mb-2">Kiểm tra điều kiện tặng điểm khuyến mại bán hàng Creta (WA_Crd_MemberRegis_CalcPointBuyCreta): dòng xe + hạng thẻ sử dụng + ngày giao xe trong khoảng hiệu lực + CCCD/MST trùng + giao dịch chưa áp dụng.</div>
            <form asp-action="CalcCreta" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-6"><input name="modelCode" class="form-control form-control-sm" placeholder="Dòng xe (vd SU2ID-CKD)" /></div>
                <div class="col-6"><input name="cardTypeUse" class="form-control form-control-sm" placeholder="Hạng thẻ sử dụng (vd P)" /></div>
                <div class="col-6"><input name="deliveryDate" type="date" class="form-control form-control-sm" placeholder="Ngày giao xe" /></div>
                <div class="col-6"><input name="idCardNo" class="form-control form-control-sm" placeholder="CCCD/MST chủ thẻ" /></div>
                <div class="col-12"><input name="dealNo" class="form-control form-control-sm" placeholder="Số giao dịch mua xe (DealNo)" /></div>
                <div class="col-12"><button class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-calculator me-1"></i>Kiểm tra điều kiện</button></div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-credit-card-2-front me-1"></i>Tặng điểm mở thẻ mới</h6>
            <div class="small text-muted mb-2">Điểm tặng mở thẻ (PointOpenCard): <b>@Model.PointOpenCard.ToString("N0")</b> điểm — tặng khi hội viên hoàn tất đăng ký (đại lý HTV)</div>
            <form asp-action="OpenCard" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="points" type="number" min="1" value="@(Model.PointOpenCard > 0 ? Model.PointOpenCard : (int?)null)" class="form-control form-control-sm" placeholder="Điểm tặng (mặc định PointOpenCard)" /></div>
                <div class="col-5"><button class="btn btn-outline-success btn-sm w-100"><i class="bi bi-gift me-1"></i>Tặng điểm</button></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Số tham chiếu / ghi chú" /></div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-ticket-perforated me-1"></i>Điểm voucher xe mới</h6>
            <div class="small text-muted mb-2">Số dư voucher: <b>@Model.PointVoucher.ToString("N0")</b> điểm (không dùng xét hạng)</div>
            <form asp-action="AwardVoucher" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="points" type="number" min="1" class="form-control form-control-sm" placeholder="Điểm voucher tặng" required /></div>
                <div class="col-5"><button class="btn btn-outline-success btn-sm w-100"><i class="bi bi-gift me-1"></i>Tặng</button></div>
                <div class="col-12"><input name="voucherCode" class="form-control form-control-sm" placeholder="Mã voucher (Prm_VoucherNewCar)" /></div>
            </form>
            <hr class="my-2" />
            <form asp-action="UseVoucher" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="points" type="number" min="1" class="form-control form-control-sm" placeholder="Điểm voucher sử dụng" required /></div>
                <div class="col-5"><button class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-cart-dash me-1"></i>Sử dụng</button></div>
                <div class="col-12"><input name="voucherCode" class="form-control form-control-sm" placeholder="Mã voucher / số RO" /></div>
            </form>
            <hr class="my-2" />
            <form asp-action="AwardVoucherNewCar" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-12"><div class="small text-muted">Tặng theo chương trình đang hiệu lực (Crd_Member_PerformVoucherNewCarX) — khớp dòng xe của hội viên.</div></div>
                <div class="col-7"><input name="modelCode" class="form-control form-control-sm" placeholder="Dòng xe (ModelCode, để trống nếu CT áp dụng tất cả)" /></div>
                <div class="col-5"><button class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-award me-1"></i>Tặng theo CT</button></div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-bag-check me-1"></i>Sử dụng điểm đổi ưu đãi</h6>
            <div class="small text-muted mb-2">Điểm khả dụng: <b>@Model.Points.ToString("N0")</b> điểm</div>
            @if (promotions.Count == 0)
            {
                <div class="text-muted small">Chưa có chương trình ưu đãi.</div>
            }
            @foreach (var p in promotions)
            {
                var canUse = Model.Points >= p.PointCost && p.Qty > 0;
                <form asp-action="UsePromotion" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-center mb-2">@Html.AntiForgeryToken()
                    <input type="hidden" name="promotionId" value="@p.Id" />
                    <div class="col-7"><div class="fw-semibold small">@p.Name</div>
                        <div class="text-muted" style="font-size:12px">@p.Description</div>
                        <span class="badge bg-warning-subtle text-warning">@p.PointCost điểm</span>
                        @if (p.Qty <= 0) { <span class="badge bg-danger-subtle text-danger">Hết</span> }</div>
                    <div class="col-5"><button class="btn btn-sm w-100 @(canUse?"btn-primary":"btn-light")" @(canUse?"":"disabled")><i class="bi bi-cart-check me-1"></i>Dùng</button></div>
                </form>
            }
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-clipboard-check me-1"></i>Ghi nhận sử dụng ưu đãi (không trừ điểm)</h6>
            <div class="small text-muted mb-2">Ghi nhận hội viên đã dùng một chương trình ưu đãi (voucher giảm giá, tặng phụ kiện...) mà ưu đãi KHÔNG quy về điểm — chỉ tracking số lượng đã dùng, không đổi điểm khả dụng.</div>
            @if (promotions.Count == 0)
            {
                <div class="text-muted small">Chưa có chương trình ưu đãi.</div>
            }
            @foreach (var p in promotions)
            {
                var canRecord = p.Qty > 0;
                <form asp-action="RecordPromotion" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-center mb-2">@Html.AntiForgeryToken()
                    <input type="hidden" name="promotionId" value="@p.Id" />
                    <div class="col-5"><div class="fw-semibold small">@p.Name</div>
                        <div class="text-muted" style="font-size:12px">@p.Description</div>
                        @if (p.Qty <= 0) { <span class="badge bg-danger-subtle text-danger">Hết</span> }</div>
                    <div class="col-3"><input name="qty" type="number" value="1" min="1" class="form-control form-control-sm" placeholder="SL" /></div>
                    <div class="col-4"><button class="btn btn-sm w-100 @(canRecord?"btn-outline-primary":"btn-light")" @(canRecord?"":"disabled")><i class="bi bi-clipboard-check me-1"></i>Ghi nhận</button></div>
                </form>
            }
        </div></div>

        @if (!string.IsNullOrWhiteSpace(Model.MemberNoIntro) || Model.PointIntro > 0)
        {
            <div class="card mb-3"><div class="card-body">
                <h6 class="fw-bold mb-2"><i class="bi bi-people me-1"></i>Giới thiệu mua xe</h6>
                <div class="small text-muted mb-2">Người giới thiệu: <b class="font-monospace">@(Model.MemberNoIntro ?? "—")</b> · Điểm thưởng: <b>@Model.PointIntro.ToString("N0")</b></div>
                <form asp-action="AwardIntro" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()
                    <button class="btn btn-outline-primary btn-sm"><i class="bi bi-gift me-1"></i>Thưởng điểm cho người giới thiệu</button>
                </form>
            </div></div>
        }

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-life-preserver me-1"></i>Điều chỉnh điểm hỗ trợ</h6>
            <div class="small text-muted mb-2">Nhân viên hỗ trợ cộng/trừ điểm thủ công (khiếu nại, sai sót, bù điểm). Điểm dương ảnh hưởng xét hạng; điểm âm chỉ trừ điểm khả dụng.</div>
            <form asp-action="SupportAdjust" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-7"><input name="points" type="number" class="form-control form-control-sm" placeholder="+/- điểm điều chỉnh" required /></div>
                <div class="col-5"><button class="btn btn-outline-warning btn-sm w-100"><i class="bi bi-life-preserver me-1"></i>Điều chỉnh</button></div>
                <div class="col-12"><input name="reason" class="form-control form-control-sm" placeholder="Lý do điều chỉnh (FunctionRemark)" /></div>
                <div class="col-12"><input name="note" class="form-control form-control-sm" placeholder="Số tham chiếu / ticket hỗ trợ" /></div>
            </form>
        </div></div>

        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-person-x me-1"></i>Vô hiệu hoá hội viên</h6>
            @if (Model.Status == MemberStatus.Cancel)
            {
                <div class="small text-muted mb-2">Hội viên đã bị vô hiệu hoá
                    @if (Model.InactiveAt.HasValue) { <span>lúc <b>@Model.InactiveAt.Value.ToString("dd/MM/yyyy HH:mm")</b></span> }.
                    Thẻ đã huỷ, điểm còn lại được đặt hết hạn cuối tháng.</div>
                @if (!string.IsNullOrWhiteSpace(Model.Remark)) { <div class="small text-muted">Lý do: @Model.Remark</div> }
            }
            else
            {
                <div class="small text-muted mb-2">Đặt hội viên về trạng thái <b>Cancel</b>, huỷ thẻ đang hiệu lực và đặt toàn bộ điểm còn lại hết hạn cuối tháng (Crd_Member_InActiveX).</div>
                <form asp-action="Inactivate" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                    <div class="col-12"><input name="remark" class="form-control form-control-sm" placeholder="Lý do vô hiệu hoá (audit)" /></div>
                    <div class="col-12"><button class="btn btn-outline-danger btn-sm w-100"><i class="bi bi-person-x me-1"></i>Vô hiệu hoá hội viên</button></div>
                </form>
            }
        </div></div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-header bg-white fw-semibold"><i class="bi bi-gift me-1"></i>Đổi quà (điểm khả dụng: @Model.Points.ToString("N0"))</div>
        <div class="card-body"><div class="row g-2">
            @foreach (var r in rewards)
            {
                var canAfford = Model.Points >= r.PointCost && r.Stock > 0;
                <div class="col-md-6"><div class="border rounded p-2 d-flex justify-content-between align-items-center h-100">
                    <div><div class="fw-semibold small">@r.Name</div><div class="text-muted" style="font-size:12px">@r.Description</div>
                        <span class="badge bg-warning-subtle text-warning">@r.PointCost điểm</span> @if(r.Stock<=0){<span class="badge bg-danger-subtle text-danger">Hết</span>}</div>
                    <form asp-action="Redeem" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<input type="hidden" name="rewardId" value="@r.Id" />
                        <button class="btn btn-sm @(canAfford?"btn-primary":"btn-light")" @(canAfford?"":"disabled")>Đổi</button></form>
                </div></div>
            }
        </div></div></div>

        <div class="card mb-3"><div class="card-header bg-white fw-semibold"><i class="bi bi-bag-check me-1"></i>Lịch sử sử dụng ưu đãi</div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th>Thời gian</th><th>Ưu đãi</th><th>Mã ưu đãi</th><th class="text-end">Điểm</th><th class="text-end">SL</th><th class="text-end">Còn lại</th><th>Tham chiếu</th></tr></thead>
            <tbody>
                @if (promotionUses.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted small py-3">Chưa có giao dịch sử dụng ưu đãi.</td></tr>
                }
                @foreach (var u in promotionUses)
                {
                    <tr>
                        <td class="small text-muted">@u.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small">@(u.PromotionNav?.Name ?? "—")@if (u.Kind == PromotionUseKind.PrProgram) { <span class="badge bg-info-subtle text-info ms-1">Ghi nhận</span> }</td>
                        <td class="small font-monospace">@u.PrProgramCode</td>
                        <td class="text-end fw-semibold @(u.Points<0?"text-danger":"text-muted")">@u.Points.ToString("N0")</td>
                        <td class="text-end text-muted">@(u.QtyPrUsed > 0 ? u.QtyPrUsed.ToString("N0") : "—")</td>
                        <td class="text-end text-muted">@u.BalanceAfter.ToString("N0")</td>
                        <td class="small text-muted">@u.RefNo</td>
                    </tr>
                }
            </tbody>
        </table></div></div>

        <div class="card mb-3"><div class="card-header bg-white fw-semibold"><i class="bi bi-receipt me-1"></i>Lịch sử tích điểm tiêu dùng dịch vụ</div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th>Thời gian</th><th class="text-end">Doanh thu</th><th class="text-end">Điểm</th><th class="text-end">Điểm xét hạng</th><th class="text-end">Số dư</th><th>Tham chiếu</th></tr></thead>
            <tbody>
                @{ var consumptions = Model.Transactions.Where(t => t.Type == PointTxType.Consumption).OrderByDescending(t => t.CreatedAt).ToList(); }
                @if (consumptions.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted small py-3">Chưa có giao dịch tích điểm tiêu dùng.</td></tr>
                }
                @foreach (var c in consumptions)
                {
                    <tr>
                        <td class="small text-muted">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end">@c.AmountChTotal.ToString("N0")</td>
                        <td class="text-end fw-semibold text-success">+@c.Points.ToString("N0")</td>
                        <td class="text-end text-muted">@c.PointChRankTotal.ToString("N0")</td>
                        <td class="text-end text-muted">@c.BalanceAfter.ToString("N0")</td>
                        <td class="small text-muted">@c.RefNo</td>
                    </tr>
                }
            </tbody>
        </table></div></div>

        <div class="card mb-3"><div class="card-header bg-white fw-semibold"><i class="bi bi-percent me-1"></i>Lịch sử chiết khấu dịch vụ</div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th>Thời gian</th><th>Hạng áp dụng</th><th class="text-end">Doanh thu</th><th class="text-end">% CK</th><th class="text-end">Tiền giảm</th><th>Tham chiếu</th></tr></thead>
            <tbody>
                @if (discounts.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted small py-3">Chưa có giao dịch chiết khấu.</td></tr>
                }
                @foreach (var d in discounts)
                {
                    <tr>
                        <td class="small text-muted">@d.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small"><span class="rank-chip" style="background:@(d.CardTypeApply?.ColorHex ?? "#94a3b8")">@(d.CardTypeApply?.Name ?? "—")</span></td>
                        <td class="text-end">@d.AmountForDC.ToString("N0")</td>
                        <td class="text-end">@d.PolicyDiscountRate.ToString("0.##")%</td>
                        <td class="text-end fw-semibold text-danger">-@d.DiscountAmount.ToString("N0")</td>
                        <td class="small text-muted">@d.RefNo</td>
                    </tr>
                }
            </tbody>
        </table></div></div>

        <div class="card mb-3"><div class="card-header bg-white fw-semibold"><i class="bi bi-ticket-perforated me-1"></i>Lịch sử điểm voucher</div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th>Thời gian</th><th>Loại</th><th>Mã voucher</th><th class="text-end">Điểm</th><th class="text-end">Còn lại</th><th>Hết hạn</th></tr></thead>
            <tbody>
                @if (vouchers.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted small py-3">Chưa có giao dịch voucher.</td></tr>
                }
                @foreach (var v in vouchers)
                {
                    <tr>
                        <td class="small text-muted">@v.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small">@(v.Type == VoucherTxType.Award ? "Tặng (VOUCHERXM)" : v.Type == VoucherTxType.BirthdayVoucher ? "Voucher sinh nhật (VOUCHERTSN)" : "Sử dụng (VOUCHERSD)")</td>
                        <td class="small font-monospace">@v.VoucherCode</td>
                        <td class="text-end fw-semibold @(v.Points>=0?"text-success":"text-danger")">@(v.Points>=0?"+":"")@v.Points.ToString("N0")</td>
                        <td class="text-end text-muted">@v.BalanceAfter.ToString("N0")</td>
                        <td class="small text-muted">@(v.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table></div></div>

        <div class="card"><div class="card-header bg-white fw-semibold"><i class="bi bi-clock-history me-1"></i>Lịch sử điểm</div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th>Thời gian</th><th>Loại</th><th>Diễn giải</th><th class="text-end">Điểm</th><th class="text-end">Số dư</th></tr></thead>
            <tbody>
                @foreach (var tx in Model.Transactions.OrderByDescending(t => t.CreatedAt))
                {
                    <tr>
                        <td class="small text-muted">@tx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="small">@TxName(tx.Type)</td>
                        <td class="small">@tx.Note</td>
                        <td class="text-end fw-semibold @(tx.Points>=0?"text-success":"text-danger")">@(tx.Points>=0?"+":"")@tx.Points.ToString("N0")</td>
                        <td class="text-end text-muted">@tx.BalanceAfter.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table></div></div>
    </div>
</div>
