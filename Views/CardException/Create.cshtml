@{
    ViewData["Title"] = "Tạo yêu cầu đặc cách thẻ";
    var members = (List<Member>)ViewBag.Members;
    var memberId = (int?)ViewBag.MemberId;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-plus-square me-2"></i>Tạo yêu cầu đặc cách thẻ</h5>
        <small class="text-muted">Crd_Card_RequestExceptionX — khởi tạo kỳ thẻ đặc cách ở trạng thái PENDING</small></div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
</div>

<div class="card"><div class="card-body">
    <form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Hội viên</label>
            <select name="memberId" class="form-select form-select-sm" required>
                <option value="">— Chọn hội viên —</option>
                @foreach (var m in members)
                {
                    <option value="@m.Id" selected="@(memberId == m.Id)">@m.Code · @m.Name (@m.Phone)</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Đại lý đặc cách</label>
            <input name="dlCodeExceptionally" class="form-control form-control-sm" placeholder="DLCodeExceptionally" />
        </div>
        <div class="col-12">
            <label class="form-label small fw-semibold">Ghi chú đại lý</label>
            <input name="remark" class="form-control form-control-sm" placeholder="Remark" />
        </div>
        <div class="col-12">
            <label class="form-label small fw-semibold">Đại lý được dùng thẻ đặc cách (Crd_CardDealerUseException)</label>
            <textarea name="dealerCodes" rows="4" class="form-control form-control-sm" placeholder="Mỗi dòng 1 mã đại lý, ví dụ:&#10;DL-HN-001&#10;DL-HCM-002"></textarea>
            <div class="form-text">Mỗi dòng (hoặc phân tách bằng dấu phẩy) là 1 mã đại lý được phép sử dụng kỳ thẻ đặc cách.</div>
        </div>

        <div class="col-12"><button class="btn btn-primary btn-sm"><i class="bi bi-send me-1"></i>Tạo yêu cầu</button></div>
    </form>
</div></div>
