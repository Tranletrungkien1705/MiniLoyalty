@model CardException
@{
    ViewData["Title"] = $"Đặc cách thẻ {Model.CardNo}";
    string StName(CardExceptionStatus s) => s switch { CardExceptionStatus.Pending => "Chờ duyệt", CardExceptionStatus.Approve => "Đã duyệt", CardExceptionStatus.Cancel => "Từ chối", _ => s.ToString() };
    string StBadge(CardExceptionStatus s) => s switch { CardExceptionStatus.Pending => "bg-warning-subtle text-warning", CardExceptionStatus.Approve => "bg-success-subtle text-success", CardExceptionStatus.Cancel => "bg-danger-subtle text-danger", _ => "bg-secondary-subtle" };
    var canApprove = Model.Status == CardExceptionStatus.Pending;
    var canReject = Model.Status == CardExceptionStatus.Pending;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-credit-card-2-front me-2"></i>@Model.CardNo
            <span class="badge @StBadge(Model.Status) ms-1">@StName(Model.Status)</span></h5>
        <small class="text-muted">Kỳ thẻ cũ: <span class="font-monospace">@(Model.CardNoPrev ?? "—")</span> · tạo @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3"><div class="card-header bg-white fw-semibold"><i class="bi bi-shop me-1"></i>Đại lý được dùng thẻ đặc cách</div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead><tr><th>Mã đại lý</th><th>Ghi chú</th></tr></thead>
            <tbody>
                @if (Model.Dealers.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-muted small py-3">Không có đại lý chỉ định.</td></tr>
                }
                @foreach (var d in Model.Dealers)
                {
                    <tr>
                        <td class="small font-monospace">@d.DealerCode</td>
                        <td class="small text-muted">@d.Remark</td>
                    </tr>
                }
            </tbody>
        </table></div></div>

        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-info-circle me-1"></i>Thông tin xử lý</h6>
            <div class="small text-muted">Hội viên: <b>@Model.Member?.Name</b> <span class="font-monospace">@Model.Member?.Code</span></div>
            <div class="small text-muted">Hạng thẻ sử dụng: <b>@(Model.CardTypeUse?.Name ?? "—")</b></div>
            <div class="small text-muted">Đại lý đặc cách: <b>@(Model.DLCodeExceptionally ?? "—")</b></div>
            <div class="small text-muted">Ghi chú đại lý: @(Model.Remark ?? "—")</div>
            <div class="small text-muted">Ghi chú HTV: @(Model.RemarkHTV ?? "—")</div>
            @if (Model.ApproveAt.HasValue) { <div class="small text-muted">Duyệt lúc @Model.ApproveAt.Value.ToString("dd/MM/yyyy HH:mm") bởi @Model.ApproveBy</div> }
        </div></div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-2"><i class="bi bi-check2-square me-1"></i>Duyệt / Từ chối</h6>
            <div class="small text-muted mb-2">Luồng: PENDING → APPROVE (duyệt: huỷ kỳ thẻ cũ, kích hoạt kỳ thẻ đặc cách). Từ chối ở bước PENDING → CANCEL.</div>
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="row g-2 mb-2">@Html.AntiForgeryToken()
                <div class="col-12"><input name="remarkHtv" class="form-control form-control-sm" placeholder="Ghi chú HTV khi duyệt" /></div>
                <div class="col-12"><button class="btn btn-success btn-sm w-100" @(canApprove ? "" : "disabled")><i class="bi bi-check2 me-1"></i>Duyệt (APPROVE)</button></div>
            </form>
            <hr class="my-2" />
            <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="row g-2">@Html.AntiForgeryToken()
                <div class="col-12"><input name="remarkHtv" class="form-control form-control-sm" placeholder="Lý do từ chối" /></div>
                <div class="col-12"><button class="btn btn-outline-danger btn-sm w-100" @(canReject ? "" : "disabled")><i class="bi bi-x-circle me-1"></i>Từ chối (CANCEL)</button></div>
            </form>
        </div></div>
    </div>
</div>
