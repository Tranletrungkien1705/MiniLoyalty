@using MiniLoyalty.Models
@using MiniLoyalty.Services
@{
    ViewData["Title"] = "Tính toán thẻ / Lộ trình lên hạng";
    var members = ViewBag.Members as List<Member> ?? new List<Member>();
    var memberId = (int?)ViewBag.MemberId;
    var result = ViewBag.Result as CardCalcResult;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-calculator me-2"></i>Tính toán thẻ / Lộ trình lên hạng</h5>
        <small class="text-muted">Crd_Card_Calc — hạng hiện tại và phần còn thiếu để lên hạng kế tiếp</small></div>
</div>

<div class="card mb-3"><div class="card-body">
    <form asp-action="Index" method="get" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Chọn hội viên</label>
            <select name="memberId" class="form-select form-select-sm">
                <option value="">— Chọn hội viên —</option>
                @foreach (var m in members)
                {
                    <option value="@m.Id" selected="@(memberId == m.Id)">@m.Code — @m.Name (@(m.RankTier?.Name ?? "—"))</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <button class="btn btn-primary btn-sm"><i class="bi bi-calculator me-1"></i>Tính toán</button>
            <span class="small text-muted ms-2">Tính theo điểm xét hạng trong kỳ (PointCardRank) và số lượt dịch vụ (QtyVisitAvail).</span>
        </div>
    </form>
</div></div>

@if (memberId is not null)
{
    if (result == null)
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Không tìm thấy hội viên.</div>
    }
    else
    {
        <div class="card"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h6 class="fw-bold mb-0">@result.MemberName <span class="text-muted small font-monospace">@result.MemberCode</span></h6>
                    <small class="text-muted">Hạng hiện tại: <b>@result.RankName</b> (bậc @result.RankValue)</small>
                </div>
                @if (result.IsMaxRank)
                {
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-trophy me-1"></i>Đã ở hạng cao nhất</span>
                }
                else
                {
                    <span class="badge bg-primary-subtle text-primary"><i class="bi bi-arrow-up-circle me-1"></i>Hạng kế tiếp: @result.NextRankName</span>
                }
            </div>

            <div class="row g-2 small mb-3">
                <div class="col-md-4 text-muted">Điểm xét hạng trong kỳ: <b class="text-dark">@result.PointAvailNow.ToString("N0")</b></div>
                <div class="col-md-4 text-muted">Lượt dịch vụ trong kỳ: <b class="text-dark">@result.QtyVisitAvail</b></div>
            </div>

            @if (!result.IsMaxRank)
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Chỉ tiêu</th><th class="text-end">Hiện có</th><th class="text-end">Ngưỡng nâng hạng</th><th class="text-end">Còn thiếu</th></tr></thead>
                        <tbody>
                            <tr>
                                <td>Điểm xét hạng</td>
                                <td class="text-end">@result.PointAvailNow.ToString("N0")</td>
                                <td class="text-end">@result.PointUpBegin.ToString("N0")</td>
                                <td class="text-end fw-semibold @(result.RevenueMiss > 0 ? "text-danger" : "text-success")">
                                    @if (result.RevenueMiss > 0) { <text>@result.RevenueMiss.ToString("N0")đ</text> } else { <text>Đủ</text> }
                                </td>
                            </tr>
                            <tr>
                                <td>Lượt dịch vụ</td>
                                <td class="text-end">@result.QtyVisitAvail</td>
                                <td class="text-end">@result.QtyVisitUpBegin</td>
                                <td class="text-end fw-semibold @(result.QtyVisitMiss > 0 ? "text-danger" : "text-success")">
                                    @if (result.QtyVisitMiss > 0) { <text>@result.QtyVisitMiss lượt</text> } else { <text>Đủ</text> }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="alert alert-info mt-3 mb-0 small">
                    <i class="bi bi-info-circle me-1"></i>
                    Để lên hạng <b>@result.NextRankName</b>, hội viên cần thêm
                    <b>@result.RevenueMiss.ToString("N0")đ</b> doanh thu dịch vụ
                    (tương đương @((result.PointUpBegin - result.PointAvailNow < 0 ? 0 : result.PointUpBegin - result.PointAvailNow).ToString("N0")) điểm xét hạng)
                    và <b>@result.QtyVisitMiss</b> lượt dịch vụ.
                </div>
            }
            else
            {
                <div class="alert alert-success mb-0 small"><i class="bi bi-trophy me-1"></i>Hội viên đang ở hạng cao nhất — không còn hạng để nâng.</div>
            }

            <div class="mt-3">
                <a asp-controller="Member" asp-action="Details" asp-route-id="@memberId" class="btn btn-outline-primary btn-sm"><i class="bi bi-person-lines-fill me-1"></i>Xem chi tiết hội viên</a>
            </div>
        </div></div>
    }
}
