@{
    ViewData["Title"] = "Tạo chương trình tặng điểm xe mới";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-car-front-fill me-2"></i>Tạo chương trình tặng điểm xe mới</h5>
        <small class="text-muted">Prm_CarNew_SaveX — khởi tạo ở trạng thái PENDING</small></div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Danh sách</a>
</div>

<div class="card"><div class="card-body">
    <form asp-action="Create" method="post" class="row g-3">@Html.AntiForgeryToken()
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Tên chương trình <span class="text-danger">*</span></label>
            <input name="PRMCNName" class="form-control form-control-sm" required />
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Đại lý áp dụng (DLCPCode) <span class="text-danger">*</span></label>
            <input name="DLCPCode" class="form-control form-control-sm" placeholder="DL-DEMO-001" required />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Ngày bắt đầu hiệu lực</label>
            <input name="EffDateStart" type="date" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Ngày kết thúc hiệu lực</label>
            <input name="EffDateEnd" type="date" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold">Điểm tặng (tất cả dòng xe)</label>
            <input name="PointValAllModel" type="number" value="0" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input name="FlagAllModel" type="checkbox" value="true" class="form-check-input" id="flagAll" checked />
                <label class="form-check-label small" for="flagAll">Áp dụng cho tất cả dòng xe</label>
            </div>
        </div>

        <div class="col-12"><hr class="my-1" /><span class="small fw-semibold text-muted">Dòng xe áp dụng (chỉ khi KHÔNG chọn "tất cả dòng xe")</span></div>
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Danh sách mã dòng xe (mỗi dòng 1 mã)</label>
            <textarea name="specModels" rows="4" class="form-control form-control-sm font-monospace" placeholder="VIOS&#10;CRV&#10;ACCENT"></textarea>
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Điểm tặng tương ứng (mỗi dòng 1 số)</label>
            <textarea name="specPoints" rows="4" class="form-control form-control-sm font-monospace" placeholder="2000&#10;3000&#10;2500"></textarea>
        </div>

        <div class="col-12">
            <label class="form-label small fw-semibold">Ghi chú</label>
            <input name="Remark" class="form-control form-control-sm" />
        </div>

        <div class="col-12"><button class="btn btn-primary btn-sm"><i class="bi bi-send me-1"></i>Tạo chương trình</button></div>
    </form>
</div></div>