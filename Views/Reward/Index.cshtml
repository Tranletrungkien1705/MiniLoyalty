@model List<Reward>
@{ ViewData["Title"] = "Quà đổi điểm"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-gift-fill me-2"></i>Quà đổi điểm</h5><small class="text-muted">@Model.Count phần quà</small></div>
</div>
<div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-md-4"><div class="card h-100 @(r.IsActive?"":"opacity-50")"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div class="rounded d-flex align-items-center justify-content-center" style="width:46px;height:46px;background:#fce7f3;color:#db2777;font-size:22px"><i class="bi bi-gift"></i></div>
                <span class="badge bg-warning-subtle text-warning fs-6">@r.PointCost điểm</span>
            </div>
            <h6 class="fw-bold mt-3 mb-1">@r.Name</h6>
            <p class="small text-muted mb-2">@r.Description</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="small text-muted">Còn: <b>@r.Stock</b></span>
                @if(!r.IsActive){<span class="badge bg-secondary-subtle text-secondary">Tạm ẩn</span>}
                else if(r.Stock<=0){<span class="badge bg-danger-subtle text-danger">Hết</span>}
                else{<span class="badge bg-success-subtle text-success">Đang phát hành</span>}
            </div>
        </div></div></div>
    }
</div>
