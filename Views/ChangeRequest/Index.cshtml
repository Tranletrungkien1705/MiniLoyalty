@model List<MemberChangeRequest>
@{
    ViewData["Title"] = "Yêu cầu thay đổi thông tin";
    var status = (ChangeRequestStatus?)ViewBag.Status;
    string StName(ChangeRequestStatus s) => s switch { ChangeRequestStatus.Pending => "Chờ duyệt", ChangeRequestStatus.Approve => "Đã duyệt", ChangeRequestStatus.Finish => "Hoàn tất", ChangeRequestStatus.Cancel => "Từ chối", _ => s.ToString() };
    string StBadge(ChangeRequestStatus s) => s switch { ChangeRequestStatus.Pending => "bg-warning-subtle text-warning", ChangeRequestStatus.Approve => "bg-info-subtle text-info", ChangeRequestStatus.Finish => "bg-success-subtle text-success", ChangeRequestStatus.Cancel => "bg-danger-subtle text-danger", _ => "bg-secondary-subtle" };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h5 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>Yêu cầu thay đổi thông tin</h5>
        <small class="text-muted">Crd_MemberChangeInfo — luồng duyệt PENDING → APPROVE → FINISH</small></div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Tạo yêu cầu</a>
</div>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm @(status==null?"btn-primary":"btn-outline-secondary")">Tất cả</a>
    <a asp-action="Index" asp-route-status="@ChangeRequestStatus.Pending" class="btn btn-sm @(status==ChangeRequestStatus.Pending?"btn-primary":"btn-outline-secondary")">Chờ duyệt</a>
    <a asp-action="Index" asp-route-status="@ChangeRequestStatus.Approve" class="btn btn-sm @(status==ChangeRequestStatus.Approve?"btn-primary":"btn-outline-secondary")">Đã duyệt</a>
    <a asp-action="Index" asp-route-status="@ChangeRequestStatus.Finish" class="btn btn-sm @(status==ChangeRequestStatus.Finish?"btn-primary":"btn-outline-secondary")">Hoàn tất</a>
    <a asp-action="Index" asp-route-status="@ChangeRequestStatus.Cancel" class="btn btn-sm @(status==ChangeRequestStatus.Cancel?"btn-primary":"btn-outline-secondary")">Từ chối</a>
</div>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>Số yêu cầu</th><th>Hội viên</th><th>Loại</th><th>Trạng thái</th><th class="text-end">Số dòng</th><th>Ngày tạo</th><th></th></tr></thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted small py-4">Chưa có yêu cầu thay đổi nào.</td></tr>
        }
        @foreach (var r in Model)
        {
            <tr>
                <td class="small font-monospace">@r.RequestNo</td>
                <td class="small">@r.Member?.Name <span class="text-muted font-monospace">@r.Member?.Code</span></td>
                <td class="small">@(r.RequestType == ChangeRequestType.ChangeInfo ? "Đổi thông tin" : "Huỷ hội viên")</td>
                <td><span class="badge @StBadge(r.Status)">@StName(r.Status)</span></td>
                <td class="text-end text-muted">@r.Details.Count</td>
                <td class="small text-muted">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-end"><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-outline-primary btn-sm">Xem</a></td>
            </tr>
        }
    </tbody>
</table></div></div>
